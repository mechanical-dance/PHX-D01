 static uint32_t midiRealtime_irqSave(void)
 {
 	uint32_t primask;
-	__asm volatile ("mrs %0, primask\ncpsid i" : "=r" (primask) :: "memory");
+	primask = 0;   /* native: engine runs on one thread, no interrupts to mask */
 	return primask;
